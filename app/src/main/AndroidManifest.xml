<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name="com.aps.APSApplication"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.APS">
        <activity android:name="com.aps.AISettingsActivity" android:exported="false" />
        <activity android:name="com.aps.SettingsActivity" android:exported="false" />
        <activity android:name="com.aps.ContextDetailActivity" android:exported="false" />
        <activity android:name="com.aps.DevelopmentTreeActivity" android:exported="false" />
        <activity android:name="com.aps.DevelopmentTaskActivity" android:exported="false" />
        <activity android:name="com.aps.SpaceActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.aps.ConversationActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
